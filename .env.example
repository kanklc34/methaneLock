# Copy this file to .env and fill in local values.
# Never commit .env or any real key.

# --- Google Earth Engine ---
# Google Cloud project registered for Earth Engine.
# Authenticate locally with: earthengine authenticate
GEE_PROJECT_ID=

# --- Ethereum Sepolia (testnet only) ---
# Private key of a testnet account, 0x-prefixed hex. Testnet funds only.
PRIVATE_KEY=

# Sepolia JSON-RPC endpoint (e.g. Infura, Alchemy or another provider)
RPC_URL=

# Sepolia chain ID (fixed)
CHAIN_ID=11155111

# MethaneRegistry address on Sepolia. Set after deployment.
CONTRACT_ADDRESS=
